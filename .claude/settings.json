{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{
          "type": "command",
          "command": "echo 'تذكير: تحقق من البيانات قبل التصرف، وأكّد خرائط الأعمدة'"
        }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "git diff --stat HEAD 2>/dev/null | tail -5",
            "statusMessage": "Checking changes..."
          }
        ]
      }
    ]
  }
}